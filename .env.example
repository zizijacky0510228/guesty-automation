# Copy this file to .env and fill in values locally.
# Do not paste secrets into chat.

GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Optional defaults.
GUESTY_BASE_URL=https://open-api.guesty.com/v1
GUESTY_TOKEN_URL=https://open-api.guesty.com/oauth2/token
GUESTY_CONVERSATION_LIMIT=25

# Only process Guesty conversations whose property/listing nickname contains
# one of these tokens.
GUESTY_ALLOWED_PROPERTY_TOKENS=3505,383,2171,6550

# Keep false until you are ready to allow actual sends.
GUESTY_SEND_ENABLED=false
GUESTY_WEBHOOK_SEND_ENABLED=false

# AI reply generation. Keep disabled until OpenAI env vars are configured.
GUESTY_AI_REPLY_ENABLED=false
GUESTY_AI_MIN_CONFIDENCE=0.78
GUESTY_AI_CONTEXT_POST_LIMIT=8
GUESTY_AI_HISTORY_BODY_CHARS=700
GUESTY_AI_EXAMPLE_LIMIT=3
GUESTY_AI_EXAMPLE_CHARS=280
GUESTY_AI_OWNER_RULES_CHARS=3200
GUESTY_AI_REPLY_STYLE_CHARS=1400
GUESTY_AI_LATEST_MESSAGE_CHARS=900
OPENAI_MAX_COMPLETION_TOKENS=350
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Optional webhook shared secret for the public Render endpoint.
GUESTY_WEBHOOK_SECRET=

# Restriction-condition alerts. The Render webhook server sends these emails
# directly; Codex/Gmail connector access is not available inside Render.
GUESTY_ALERT_EMAIL_ENABLED=true
GUESTY_ALERT_EMAIL_TO=info@zhanhongltd.com
GUESTY_ALERT_EMAIL_FROM=
GUESTY_ALERT_SMTP_HOST=smtp.gmail.com
GUESTY_ALERT_SMTP_PORT=587
GUESTY_ALERT_SMTP_USERNAME=
GUESTY_ALERT_SMTP_PASSWORD=
GUESTY_ALERT_SMTP_STARTTLS=true

# Guesty requires a module object for message sends. Configure this after
# checking which delivery module you want to use for your account/channel.
# Example placeholder only:
# GUESTY_SEND_MODULE_JSON={"type":"platform"}
